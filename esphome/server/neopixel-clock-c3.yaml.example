substitutions:
  node_name: neopixel-clock-c3
  # Tested published revision; update deliberately for both packages and component.
  project_revision: "615b613fa685de19a1f3de5de96a8356f9583bc3"
  led_pin: GPIO4
  timezone: "Europe/Berlin"

packages:
  clock:
    url: https://github.com/Benksterinho/7segment_neopixel_digits.git
    ref: ${project_revision}
    refresh: never
    files:
      - esphome/packages/clock-common.yaml
      - esphome/packages/board-c3.yaml

external_components:
  - source:
      type: git
      url: https://github.com/Benksterinho/7segment_neopixel_digits.git
      ref: ${project_revision}
      path: esphome/components
    components: [modular_7segment]
    refresh: never

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

api:
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome
    encryption:
      key: !secret api_encryption_key

mqtt:
  broker: !secret mqtt_host
  port: !secret mqtt_port
  username: !secret mqtt_user
  password: !secret mqtt_password
